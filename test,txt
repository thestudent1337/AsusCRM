foreach ($n in 'GoodixMocSensorAdapterNw.dll','GoodixMocSensorAdapter.dll') { $f = Join-Path 'C:\Windows\System32\WinBioPlugins' $n; if (-not (Test-Path $f)) { Write-Output "$n : not present"; continue }; Write-Output ""; Write-Output "=== $n ver $((Get-Item $f).VersionInfo.FileVersion) ==="; $b = [IO.File]::ReadAllBytes($f); $hits = @(); foreach ($t in @([Text.Encoding]::Unicode.GetString($b), [Text.Encoding]::ASCII.GetString($b))) { foreach ($m in [regex]::Matches($t, '[\u0020-\u007E]{5,}')) { if ($m.Value -match 'ProgramData|Adapter-|\.log|\.dmp') { $hits += $m.Value } } }; $hits | Select-Object -Unique | ForEach-Object { Write-Output "    $_" } }
